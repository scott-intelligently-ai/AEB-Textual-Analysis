# Copy to .env.local and fill in. The same values go in Vercel and, for the
# keys the worker uses, in Railway. Never commit the filled-in file.

# Supabase project. The anon key is public; the service role key is not.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres. DATABASE_URL is the pooler (port 6543). DIRECT_URL is the direct
# connection (port 5432) and is used only by `npm run db:migrate`.
DATABASE_URL=
DIRECT_URL=

# Comma-separated emails allowed to sign in. Anyone else is refused.
# Example: you@example.com
ALLOWED_EMAILS=

# At least one provider key is required. Which provider does each job is
# chosen on the Settings page. The worker needs the key for scan conversion;
# the website needs the key for tone and term suggestions.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Models, chosen from each provider's model list. Change these to move to
# newer models without touching the code.
ANTHROPIC_OCR_MODEL=claude-sonnet-5-5
ANTHROPIC_ANALYSIS_MODEL=claude-sonnet-5-5
OPENAI_OCR_MODEL=gpt-6.2-sol
OPENAI_ANALYSIS_MODEL=gpt-6.2-sol
